# Quimia Extractor AI
EXTRACTOR_API_URL=http://localhost:8000
EXTRACTOR_API_TOKEN=   
EXTRACTOR_TIMEOUT_SECONDS=60

# PostgreSQL Quimia
QUIMIA_DB_HOST=
QUIMIA_DB_PORT=5432
QUIMIA_DB_NAME=
QUIMIA_DB_USER=
QUIMIA_DB_PASSWORD=
QUIMIA_DB_SSLMODE=require

# Estado e documentos locais
STATE_DB_PATH=./data/state.db
DOCUMENT_STORAGE_PATH=./data/documents
MANUAL_INBOX_PATH=./data/manual_inbox
OFFICIAL_SDS_CATALOG_PATH=./config/official_sds_catalog.yaml
FDS_MIN_AUTO_SOURCE_SCORE=85

# ZenRows: fallback quando o site oficial bloqueia (403/Cloudflare/JS), busca web de FDS
# e Google Images. Sem chave, providers oficiais (HTTP direto) e manual inbox continuam
# funcionando; só enrich-images exige a chave. https://app.zenrows.com
ZENROWS_API_KEY=
IMAGE_SEARCH_COUNTRY=br
IMAGE_SEARCH_LANGUAGE=pt-br
IMAGE_SEARCH_MAX_RESULTS=20

# Processamento de imagens
# Canvas = padrão dos PNGs do quimia-bd (1254x1254). IMAGE_MIN_SIZE = maior lado do produto na foto original.
IMAGE_CANVAS_SIZE=1254
IMAGE_MIN_SIZE=256
IMAGE_OUTER_FRAME_RATIO=0.03
IMAGE_OUTER_FRAME_TRANSPARENT_RATIO=0.98
IMAGE_AUTO_APPROVE_SCORE=0.90
IMAGE_REVIEW_SCORE=0.70

# Repo local do quimia-bd. NENHUM push remoto é feito.
QUIMIA_BD_LOCAL_PATH=

# BridgeSDS: opcional/futuro; não é requisito da v0.2.
BRIDGESDS_API_URL=
BRIDGESDS_API_KEY=
